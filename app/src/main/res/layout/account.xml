<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/user"
            android:text="@string/user"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:textColor="@color/text_primary"/>

        <EditText
            android:id="@+id/email"
            android:hint="@string/email"
            android:singleLine="true"
            android:inputType="textEmailAddress"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/input_bg"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <EditText
            android:id="@+id/password"
            android:hint="@string/password"
            android:singleLine="true"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@color/input_bg"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <TextView
            android:id="@+id/forgotPassword"
            android:text="Forgot Password?"
            android:textSize="14sp"
            android:textColor="@color/link_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_gravity="start"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:onClick="resetPassword"/>

        <Button
            android:id="@+id/begin"
            android:onClick="begin"
            android:text="@string/begin"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/btn_begin_bg"
            android:textColor="#ffffff"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/googleBegin"
            android:onClick="beginWithGoogle"
            android:text="@string/begin_with_google"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/btn_google_bg"
            android:textColor="#ffffff"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/logout"
            android:onClick="logout"
            android:text="@string/logout"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/delete"
            android:textColor="#ffffff"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>
